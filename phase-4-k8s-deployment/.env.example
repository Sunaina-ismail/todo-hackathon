# ============================================
# Database Configuration (Neon PostgreSQL)
# ============================================
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require&application_name=todo-app

# ============================================
# Authentication (Better Auth)
# ============================================
# CRITICAL: Generate a secure random secret
# Use: openssl rand -base64 64
# MUST match between frontend and backend
BETTER_AUTH_SECRET=your-super-secret-key-here-make-it-long-and-random-at-least-32-chars

# ============================================
# Server Configuration (Backend)
# ============================================
HOST=0.0.0.0
PORT=8001

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION=604800  # 7 days in seconds

# ============================================
# Neon Database Pool Configuration
# ============================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=300  # 5 minutes

# ============================================
# Environment
# ============================================
ENVIRONMENT=development  # development, staging, production

# ============================================
# Phase 3: AI Chatbot Configuration
# ============================================

# LLM Provider Configuration
# Supported providers: openai | gemini | groq | openrouter
LLM_PROVIDER=openrouter

# OpenAI Configuration (Default Provider)
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Gemini Configuration (Uncomment to use)
# GEMINI_API_KEY=AIza...
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Groq Configuration (Uncomment to use)
# GROQ_API_KEY=gsk_...
# GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# OpenRouter Configuration (Uncomment to use)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-20b:free

# MCP Server Configuration
MCP_SERVER_NAME=todo-task-server

# ============================================
# Cloudflare R2 Storage (Optional)
# ============================================
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
