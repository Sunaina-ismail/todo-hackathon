# ============================================
# Database Configuration (Neon PostgreSQL)
# ============================================
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ============================================
# Authentication (Better Auth)
# ============================================
# CRITICAL: Generate a secure random secret
# Use: openssl rand -base64 64
# MUST match backend BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=your_secure_random_secret_here_min_32_chars

# Better Auth URLs
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Backend API Configuration
# ============================================
# API URL (backend endpoint)
NEXT_PUBLIC_API_URL=http://localhost:8001

# ============================================
# Phase 3: ChatKit Configuration
# ============================================
# ChatKit endpoint for AI-powered conversational task management
# This URL points to the backend ChatKit server endpoint
NEXT_PUBLIC_CHATKIT_URL=http://localhost:8001/api/chatkit

# ============================================
# Production Deployment (Optional)
# ============================================
# For production, update these with your actual domains:
# BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_CHATKIT_URL=https://api.yourdomain.com/api/chatkit
